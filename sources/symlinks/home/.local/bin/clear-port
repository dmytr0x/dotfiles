#!/bin/bash
#
# Kill the process running on the provided port.
#
# - Release the port:
#
# `clear-port {{port}}`
#
# ---
# Author: Nick Plekhanov, https://nikkhan.com/
# License: MIT
# https://github.com/nicksp/dotfiles

set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Usage: $(basename "$0") <port_number>"
  exit 1
fi

if port_nums="$(lsof -ti4TCP:"$1")"; then
  pids=()
  while IFS= read -r pid; do
    [ -n "$pid" ] && pids+=("$pid")
  done <<< "$port_nums"

  if [ "${#pids[@]}" -gt 0 ]; then
    kill "${pids[@]}"
  fi
fi
